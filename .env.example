# SolePartner Environment Configuration Template
# Duplicate this file as .env or inject values via build-time --dart-define flags:
# e.g.: flutter build apk --dart-define=AI_API_KEY=gsk_...

# AI Provider Configuration (OpenAI-compatible or Groq)
AI_ENDPOINT=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=YOUR_INFERENCE_API_KEY_HERE

# Solana Cluster Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# Application Metadata
APP_NAME=SolePartner
APP_ENVIRONMENT=production

